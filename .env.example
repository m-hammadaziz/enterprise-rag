# Postgres (docker compose overrides the host to "db" for the api container)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Any OpenAI-compatible endpoint. Leave GROQ_API_KEY empty for offline extractive mode.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# USD per 1M tokens (used for cost tracking)
LLM_INPUT_PRICE_PER_MTOK=0.59
LLM_OUTPUT_PRICE_PER_MTOK=0.79

# Embeddings: sentence-transformers (real) | hash (offline, no download)
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Reranker: cross-encoder (real) | lexical (offline) | none
RERANK_BACKEND=cross-encoder
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
